library(sp)
#load countries
countries <- lapply(read_excel(paste0('countries.xlsx')),as.list)
countries_EU <- c('BE','BG','CZ','DK','DE','EE','IE','GR','ES','FR','HR','IT','CY','LV','LT','LU','HU','MT','NL','AT','PL','PT','RO','SI','SK','FI','SE')
#load countries shapefile
