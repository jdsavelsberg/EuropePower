@Article{Muesgens2014,
  Title                    = {Economics and design of balancing power markets in {G}ermany},
  Author                   = {Felix Muesgens and Axel Ockenfels and Markus Peek},
  Journal                  = {International Journal of Electrical Power \& Energy Systems },
